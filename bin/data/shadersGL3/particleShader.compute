#version 440
#pragma include "common.glsl"

layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer Agents { Agent agents[]; };
layout(std430, binding = 1) readonly buffer Trails { vec4 trails[]; };
layout(std430, binding = 3) buffer Contributions { uvec4 contributions[]; };
layout(std430, binding = 4) readonly buffer Sites { vec4 sites[]; };
layout(std430, binding = 5) buffer Statistics { TeamStats stats[]; };
layout(std430, binding = 6) buffer Attacks { uint attacks[]; };

uniform ivec2 gridSize;
uniform int agentsPerTeam;
uniform int turn;
uniform int budget;
uniform ivec3 costs;
uniform float speed;
uniform float sensorDistance;
uniform float turnAngle;
uniform float scentAttraction;
uniform float freshSpace;
uniform float trailFollowing;
uniform float avoidance;
uniform float exploration;
uniform float routeThreshold;

int cellAt(vec2 position) {
    ivec2 cell = clamp(ivec2(position), ivec2(0), gridSize - 1);
    return cell.x + cell.y * gridSize.x;
}

// Read only the local field. Colony coordinates never enter steering.
float otherScent(vec4 field, int origin, int previous) {
    if (previous != origin) return field[previous];
    float strongest = 0.0;
    for (int colony = 0; colony < 3; ++colony) {
        if (colony != origin) strongest = max(strongest, field[colony]);
    }
    return strongest;
}

float directionScore(Agent agent, vec2 direction, float offset) {
    vec2 samplePosition = agent.position.xy + direction * sensorDistance;
    if (any(lessThan(samplePosition, vec2(0))) || any(greaterThanEqual(samplePosition, vec2(gridSize)))) {
        return -1000.0;
    }
    int team = int(agent.identity.x);
    int origin = int(agent.identity.y % 3u);
    int previous = int(agent.identity.z % 3u);
    int field = cellAt(samplePosition) * TEAM_COUNT;
    vec4 sampleField = trails[field + team];
    vec4 here = trails[cellAt(agent.position.xy) * TEAM_COUNT + team];
    float currentSignal = otherScent(here, origin, previous);
    float scentGradient = (otherScent(sampleField, origin, previous) - currentSignal) / (1.0 + currentSignal);
    float ownGradient = (sampleField[origin] - here[origin]) / (1.0 + here[origin]);
    float foreignScent = 0.0;
    float foreignRoute = 0.0;
    for (int other = 0; other < TEAM_COUNT; ++other) {
        if (other == team) continue;
        vec4 enemy = trails[field + other];
        foreignScent = max(foreignScent, max(max(enemy.x, enemy.y), max(enemy.z, enemy.w)));
        foreignRoute = max(foreignRoute, enemy.w);
    }
    float crossingPenalty = foreignRoute >= routeThreshold ? 1.0 : (foreignScent >= 0.05 ? 0.25 : 0.0);
    // All agents respond to local traffic trails, including temporary branches
    // and junctions that haven't reached another site.
    float routeScore = sampleField.w / (1.0 + sampleField.w);
    return 3.0 * scentAttraction * scentGradient - freshSpace * ownGradient +
           trailFollowing * routeScore - avoidance * crossingPenalty + 0.08 * cos(offset);
}

bool reserveEnergy(uint team, uint cost) {
    uint used = atomicAdd(stats[team].spent, 0u);
    while (used + cost <= uint(budget)) {
        uint previous = atomicCompSwap(stats[team].spent, used, used + cost);
        if (previous == used) return true;
        used = previous;
    }
    return false;
}

void main() {
    uint invocation = gl_GlobalInvocationID.x;
    if (invocation >= uint(TEAM_COUNT * agentsPerTeam)) return;
    uint team = invocation / uint(agentsPerTeam);
    // Rotate which physical agents get the first chance at the shared budget.
    // Unspent energy can pay for expensive actions by any other team member.
    uint local = (invocation % uint(agentsPerTeam) + uint(turn) * 499u) % uint(agentsPerTeam);
    uint index = team * uint(agentsPerTeam) + local;
    Agent agent = agents[index];
    agent.state.z = 0.0;
    if (speed <= 0.0 || budget == 0) {
        agents[index] = agent;
        return;
    }

    float bestScore = -1e10;
    // Persistent random walk: one small angular perturbation, rather than
    // picking a completely unrelated direction at each step in empty space.
    float wander = (random01(agent.identity.w ^ hash(uint(turn) + 73u)) - 0.5) * exploration;
    float baseHeading = agent.position.z + wander;
    float heading = baseHeading;
    for (int candidate = -2; candidate <= 2; ++candidate) {
        float offset = float(candidate) * turnAngle;
        float angle = baseHeading + offset;
        vec2 direction = vec2(cos(angle), sin(angle));
        float score = directionScore(agent, direction, offset);
        if (score > bestScore) {
            bestScore = score;
            heading = angle;
        }
    }
    vec2 nextPosition = clamp(agent.position.xy + vec2(cos(heading), sin(heading)) * speed,
                              vec2(0.01), vec2(gridSize) - 0.01);
    int field = cellAt(nextPosition) * TEAM_COUNT;
    float foreign = 0.0;
    float foreignRoute = 0.0;
    for (int other = 0; other < TEAM_COUNT; ++other) {
        if (other == int(team)) continue;
        vec4 enemy = trails[field + other];
        foreign = max(foreign, max(max(enemy.x, enemy.y), max(enemy.z, enemy.w)));
        foreignRoute = max(foreignRoute, enemy.w);
    }
    int action = foreignRoute >= routeThreshold ? 2 : (foreign >= 0.05 ? 1 : 0);
    if (!reserveEnergy(team, uint(costs[action]))) {
        agents[index] = agent;
        return;
    }

    agent.state.z = float(action + 1);
    if (action == 2) {
        atomicAdd(stats[team].attacking, 1u);
        atomicAdd(attacks[field + int(team)], 1u);
        // An attacker waits at the border; only a successful contested clearing
        // lets it cross on a later turn. Losing consumes energy, not population.
        agent.position.z = heading;
    } else {
        if (action == 0) atomicAdd(stats[team].exploring, 1u);
        else atomicAdd(stats[team].encroaching, 1u);
        float traveled = distance(nextPosition, agent.position.xy);
        agent.position.w += traveled;
        agent.position.xy = nextPosition;
        agent.position.z = heading;
        // Ordinary traffic is enough to build a trail. There is no site-visit
        // prerequisite, and fighting in place does not maintain a route.
        if (traveled > 0.0001) {
            atomicAdd(contributions[cellAt(nextPosition) * TEAM_COUNT + int(team)].w, 4u);
        }
        // Coordinates are consulted only for physical contact with a site,
        // never to choose a heading or infer a distant site's direction.
        for (uint colony = 0u; colony < 3u; ++colony) {
            uint visited = team * 3u + colony;
            if (visited == agent.identity.y || sites[visited].z == 0.0) continue;
            if (distance(nextPosition, sites[visited].xy) > 2.0) continue;
            agent.state.y += 1.0;
            agent.position.w = 0.0;
            agent.identity.z = agent.identity.y;
            agent.identity.y = visited;
            // Reverse along the route just traveled, then navigate using the
            // previous colony's locally available scent.
            agent.position.z += 3.14159265359;
            atomicAdd(stats[team].arrivals, 1u);
            break;
        }
    }
    int depositField = cellAt(agent.position.xy) * TEAM_COUNT + int(team);
    atomicAdd(contributions[depositField][int(agent.identity.y % 3u)], 2u);
    agents[index] = agent;
}
