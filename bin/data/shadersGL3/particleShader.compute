#version 440
#pragma include "common.glsl"

layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer Agents { Agent agents[]; };
layout(std430, binding = 1) readonly buffer Trails { vec4 trails[]; };
layout(std430, binding = 2) writeonly buffer Plans { Plan plans[]; };
layout(std430, binding = 4) readonly buffer Sites { vec4 sites[]; };
layout(std430, binding = 5) buffer Statistics { TeamStats stats[]; };
layout(std430, binding = 6) buffer Attacks { uvec2 attacks[]; };
layout(std430, binding = 7) buffer History { vec2 history[]; };

uniform ivec2 gridSize;
uniform int agentsPerTeam;
uniform int turn;
uniform int budget;
uniform int explorationSteps;
uniform ivec3 costs;
uniform float speed;
uniform float sensorDistance;
uniform float turnAngle;
uniform float scentAttraction;
uniform float freshSpace;
uniform float trailFollowing;
uniform float avoidance;
uniform float exploration;
uniform float routeThreshold;

#pragma include "journey.glsl"

int cellAt(vec2 position) {
    ivec2 cell = clamp(ivec2(position), ivec2(0), gridSize - 1);
    return cell.x + cell.y * gridSize.x;
}

int actionAt(vec2 position, uint team) {
    int field = cellAt(position) * TEAM_COUNT;
    float scent = 0.0, route = 0.0;
    for (int other = 0; other < TEAM_COUNT; ++other) {
        if (other == int(team)) continue;
        vec4 enemy = trails[field + other];
        scent = max(scent, max(max(enemy.x, enemy.y), max(enemy.z, enemy.w)));
        route = max(route, enemy.w);
    }
    return route >= routeThreshold ? 3 : (scent >= 0.05 ? 2 : 1);
}

float otherScent(vec4 field, int origin, int previous) {
    if (previous != origin) return field[previous];
    float strongest = 0.0;
    for (int colony = 0; colony < 3; ++colony) {
        if (colony != origin) strongest = max(strongest, field[colony]);
    }
    return strongest;
}

float directionScore(Agent agent, vec2 direction, float offset, vec2 returnTarget) {
    vec2 samplePosition = agent.position.xy + direction * sensorDistance;
    if (any(lessThan(samplePosition, vec2(0))) || any(greaterThanEqual(samplePosition, vec2(gridSize)))) return -1000.0;
    int team = int(agent.identity.x);
    vec4 sampleField = trails[cellAt(samplePosition) * TEAM_COUNT + team];
    vec4 here = trails[cellAt(agent.position.xy) * TEAM_COUNT + team];
    bool returning = agent.state.x > 0.5;
    int origin = int(agent.identity.y % 3u);
    int previous = int(agent.identity.z % 3u);
    float hereScent = returning ? here[int(agent.journey.x % 3u)] : otherScent(here, origin, previous);
    float sampleScent = returning ? sampleField[int(agent.journey.x % 3u)] : otherScent(sampleField, origin, previous);
    float gradient = (sampleScent - hereScent) / (1.0 + hereScent);
    float ownGradient = (sampleField[origin] - here[origin]) / (1.0 + here[origin]);
    int action = actionAt(samplePosition, agent.identity.x);
    float penalty = action == 3 ? 1.0 : (action == 2 ? 0.25 : 0.0);
    float score = 3.0 * scentAttraction * gradient + trailFollowing * sampleField.w / (1.0 + sampleField.w);
    if (returning) {
        vec2 targetDirection = returnTarget - agent.position.xy;
        score += 3.0 * dot(direction, targetDirection / max(length(targetDirection), 0.001));
        score -= 3.0 * avoidance * penalty;
    } else {
        score -= freshSpace * ownGradient + avoidance * penalty;
    }
    return score + 0.08 * cos(offset);
}

uint returnWaypoint(Agent agent, uint index) {
    uint base = index * HISTORY_CAPACITY;
    uint immediate = agent.journey.y > 1u ? agent.journey.y - 2u : 0u;
    uint selected = immediate;
    vec2 previous = agent.position.xy;
    float pathLength = 0.0, pathCost = 0.0, selectedCost = 0.0;
    // Candidate shortcuts stay inside the local sensor radius and only connect
    // positions this agent has already visited. No unseen site coordinates.
    for (int offset = 0; offset < 8; ++offset) {
        if (uint(offset) > immediate) break;
        uint point = immediate - uint(offset);
        vec2 waypoint = history[base + point];
        if (distance(agent.position.xy, waypoint) > sensorDistance) break;
        float segment = distance(previous, waypoint);
        pathLength += segment;
        pathCost += segment * float(costs[actionAt((previous + waypoint) * 0.5, agent.identity.x) - 1]);
        previous = waypoint;
        if (offset > 0 && distance(agent.position.xy, waypoint) < pathLength * 0.99) {
            selected = point;
            selectedCost = pathCost;
        }
    }
    if (selected != immediate) {
        vec2 target = history[base + selected];
        float directCost = 0.0;
        for (int sampleIndex = 1; sampleIndex <= 3; ++sampleIndex) {
            int action = actionAt(mix(agent.position.xy, target, float(sampleIndex) / 3.0), agent.identity.x);
            if (action == 3) return immediate;
            directCost += float(costs[action - 1]) / 3.0;
        }
        directCost *= distance(agent.position.xy, target);
        if (directCost >= selectedCost) return immediate;
    }
    return selected;
}

void main() {
    uint invocation = gl_GlobalInvocationID.x;
    if (invocation >= uint(TEAM_COUNT * agentsPerTeam)) return;
    uint team = invocation / uint(agentsPerTeam);
    uint local = (invocation % uint(agentsPerTeam) + uint(turn) * 499u) % uint(agentsPerTeam);
    uint index = team * uint(agentsPerTeam) + local;
    Agent agent = agents[index];
    agent.state.z = 0.0;
    Plan plan = Plan(agent.position, uvec4(0));
    if (speed <= 0.0 || budget == 0) {
        agents[index] = agent;
        plans[index] = plan;
        return;
    }

    if (agent.state.x < 0.5 && agent.journey.y == 1u && agent.journey.z == 0u) {
        history[index * HISTORY_CAPACITY] = sites[agent.journey.x].xy;
    }
    float fraction = random01(agent.identity.w ^ 0x71baf123u);
    uint limit = max(1u, uint(float(explorationSteps) * (agent.state.w == 0.0 ? fraction : 0.5 + fraction)));
    if (agent.state.x < 0.5 && (agent.journey.z >= limit || agent.journey.y >= HISTORY_CAPACITY)) agent.state.x = 1.0;
    if (agent.state.x > 0.5 && distance(agent.position.xy, sites[agent.journey.x].xy) <= 1.25) finishReturn(agent, index);

    bool returning = agent.state.x > 0.5;
    uint waypoint = returning ? returnWaypoint(agent, index) : 0u;
    vec2 target = returning ? history[index * HISTORY_CAPACITY + waypoint] : agent.position.xy;
    float wander = (random01(agent.identity.w ^ hash(uint(turn) + 73u)) - 0.5) * exploration;
    float baseHeading = returning ? atan(target.y - agent.position.y, target.x - agent.position.x) + wander * 0.1 :
                                    agent.position.z + wander;
    float heading = baseHeading, bestScore = -1e10;
    for (int candidate = -2; candidate <= 2; ++candidate) {
        float offset = float(candidate) * turnAngle;
        float angle = baseHeading + offset;
        float score = directionScore(agent, vec2(cos(angle), sin(angle)), offset, target);
        if (score > bestScore) { bestScore = score; heading = angle; }
    }
    float stepLength = returning ? min(speed, distance(agent.position.xy, target)) : speed;
    vec2 next = clamp(agent.position.xy + vec2(cos(heading), sin(heading)) * stepLength, vec2(0.01), vec2(gridSize) - 0.01);
    uint action = uint(actionAt(next, team));
    plan.step = vec4(next, heading, 0);
    plan.action = uvec4(action, 0u, waypoint, 0u);
    // Only paid attacks generate threats. Defense will run before any ordinary
    // movement can consume the remaining team energy.
    if (action == 3u && reserveEnergy(team, uint(costs.z))) {
        plan.action.y = 1u;
        atomicAdd(stats[team].attacking, 1u);
        atomicAdd(attacks[cellAt(next) * TEAM_COUNT + int(team)].x, 1u);
    }
    agents[index] = agent;
    plans[index] = plan;
}
